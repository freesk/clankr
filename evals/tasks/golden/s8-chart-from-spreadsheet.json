  },
  {
    "id": "s8-million-row-bar",
    "scenario": "S8",
    "title": "Chart an aggregate of a 1,000,000-row file (M4 exit criterion)",
    "requires": ["inspect_data", "query_sql", "make_chart"],
    "chart": true,
    "fixtures": [
      {
        "kind": "generated",
        "generator": "csv",
        "path": "sales.csv",
        "options": { "dataset": "sales", "rows": 1000000 }
      }
    ],
    "steps": [
      {
        "prompt": "Chart total quantity by region from sales.csv as a bar chart and save it as quantity-by-region.pdf."
      }
    ],
    "assertions": [
      { "kind": "pdf-created", "directory": "." },
      { "kind": "chart-spec", "directory": ".", "mark": "bar", "fields": ["region"] }
    ]
  },
  {
