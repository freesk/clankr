[
  {
    "id": "s8-headcount-stacked-bar",
    "scenario": "S8",
    "title": "Stacked bar chart to PDF",
    "requires": ["inspect_data", "query_sql", "make_chart"],
    "chart": true,
    "fixtures": [
      {
        "kind": "generated",
        "generator": "xlsx",
        "path": "headcount_2025.xlsx",
        "options": { "dataset": "headcount" }
      }
    ],
    "steps": [
      {
        "prompt": "Chart monthly headcount by department from headcount_2025.xlsx as a stacked bar, save as headcount.pdf."
      }
    ],
    "assertions": [
      { "kind": "pdf-created", "directory": "." },
      {
        "kind": "chart-spec",
        "directory": ".",
        "mark": "bar",
        "fields": ["month", "department"],
        "stacked": true
      }
    ]
  },
  {
    "id": "s8-engineering-line",
    "scenario": "S8",
    "title": "Line chart of one filtered series",
