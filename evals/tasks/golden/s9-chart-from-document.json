  {
    "id": "s9-revenue-bar",
    "scenario": "S9",
    "title": "Bar chart of the first table in a document",
    "requires": ["inspect_data", "make_chart"],
    "chart": true,
    "fixtures": [
      {
        "kind": "generated",
        "generator": "docx",
        "path": "board-report.docx",
        "options": { "document": "board-report" }
      }
    ],
    "steps": [
      {
        "prompt": "Make a bar chart of revenue by quarter from the first table in board-report.docx, saved as revenue.pdf."
